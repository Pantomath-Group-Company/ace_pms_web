# Copy to `.env` and fill in. Server-side only — never prefix with VITE_.
# In production set the same keys in Vercel → Project → Settings → Environment Variables.
SMTP_HOST=smtp.falconide.com
SMTP_PORT=465
SMTP_USERNAME=acmmails
SMTP_PASSWORD=
SMTP_FROM=donotreply@acm.co.in
NOTIFY_TO=pms@acm.co.in

# Optional: override the Supabase project (falls back to src/lib/cms/supabaseClient.ts)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
